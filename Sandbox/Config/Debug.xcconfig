//
//  Debug.xcconfig
//  Sandbox
//
//  Single target, single partner. Everything brand-specific lives here.
//

#include? "../../Pods/Target Support Files/Pods-Sandbox/Pods-Sandbox.debug.xcconfig"

PARTNER = Sandbox
APP_NAME = IV Sandbox
PRODUCT_BUNDLE_IDENTIFIER = ai.instaview.guardian.sandbox
APP_ENVIRONMENT = Prod
APP_VERSION = 1.0.0

// Push. The App ID must have the Push Notifications capability enabled or
// signing will fail with a missing-entitlement error.
CODE_SIGN_ENTITLEMENTS = Sandbox/Sandbox.entitlements

// Taken from GoogleService-Info.plist -> REVERSED_CLIENT_ID.
// Required for the Google sign-in callback URL scheme.
REVERSED_CLIENT_ID = com.googleusercontent.apps.2606432480-k799dthuo4qubqs8b7b73sun610n1esu
